# The Go API's address. In the cluster: http://cyberlab-mirror-api:8080
API_URL=http://localhost:8080
# The header a trusted edge puts the browser's IP in, or "none" when there is no
# such edge (kubectl port-forward): then no IP is forwarded at all
CLIENT_IP_HEADER=none
# The sign-in providers turned on in the Go API, e.g. github
OAUTH_PROVIDERS=
